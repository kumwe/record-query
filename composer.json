{
  "name": "kumwe/record-query",
  "description": "Closed bounded business record query grammar, projections and deterministic canonicalization.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/record-query",
  "require": {
    "php": "^8.5",
    "php-64bit": "*",
    "ext-json": "*",
    "kumwe/record-values": "dev-agent/extraction-v2-business-data",
    "kumwe/business-definition": "dev-agent/candidate-sequence-dependency-v2",
    "kumwe/conversion": "0.1.0",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\Record\\Query\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Record\\Query\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "lint": "php tools/lint.php",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "manifests": "php tools/manifests.php",
    "check": [
      "composer validate --strict",
      "@lint",
      "@architecture",
      "@test",
      "@analyse",
      "@cs",
      "@manifests"
    ],
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "clean-consumer": "php tools/verify-clean-consumer.php",
    "security:audit": "composer audit --abandoned=fail",
    "architecture": "php tools/architecture.php"
  },
  "config": {
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/tests",
      "/tools",
      "/.github",
      "/composer.local.json",
      "/composer.local.lock",
      "/composer.lock",
      "/phpstan.neon",
      "/phpcs.xml",
      "/phpunit.xml",
      "/.phpstan-cache",
      "/.phpunit.cache",
      "/.gitignore",
      "/.gitattributes",
      "/composer.candidate.json",
      "/composer.candidate.lock"
    ]
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/business-definition.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/record-values.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/sequence.git"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
